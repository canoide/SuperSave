# Port on which the local Express server runs
PORT=5000

# Secret key used to sign JWT tokens. Replace with a secure random key.
JWT_SECRET=super_secret_token_key_for_testing

# MongoDB connection string.
# Leave blank to use 'mongodb-memory-server' for local testing (not recommended in production).
# In Vercel, populate this with your MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/supermarket_optimizer?retryWrites=true&w=majority
